rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════
    // HÀM DÙNG CHUNG
    // ═══════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.email == 'trntui6@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
      );
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isTeacher() || isOwner(userId);
      allow delete: if isTeacher();
    }

    // ═══════════════════════════════════════════
    // LESSONS
    // ═══════════════════════════════════════════
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ═══════════════════════════════════════════
    // ASSIGNMENTS + SUBCOLLECTION ANSWERKEY
    // ═══════════════════════════════════════════
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();

      // ⭐⭐ ĐÂY LÀ DÒNG QUAN TRỌNG NHẤT ⭐⭐
      // Chỉ GV đọc/ghi được đáp án — HS TUYỆT ĐỐI không đọc được
      match /answerKey/{docId} {
        allow read, write: if isTeacher();
      }
    }

    // ═══════════════════════════════════════════
    // SUBMISSIONS (bài làm)
    // ═══════════════════════════════════════════
    match /submissions/{subId} {
      allow read: if isTeacher() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isTeacher();
    }

    // ═══════════════════════════════════════════
    // VIEWLOGS (log xem đề)
    // ═══════════════════════════════════════════
    match /viewLogs/{logId} {
      allow read: if isTeacher() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isTeacher();
    }

    // ═══════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ═══════════════════════════════════════════
    // SETTINGS
    // ═══════════════════════════════════════════
    match /settings/{setId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ═══════════════════════════════════════════
    // AUDITLOGS
    // ═══════════════════════════════════════════
    match /auditLogs/{logId} {
      allow read: if isTeacher();
      allow create: if isSignedIn();
    }

    // ═══════════════════════════════════════════
    // CHẶN TẤT CẢ CÒN LẠI
    // ═══════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}