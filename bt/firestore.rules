rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function classChangeOn() {
      return get(/databases/$(database)/documents/settings/system).data.allowChangeClass == true;
    }

    // ── USERS ─
    match /users/{uid} {
      allow read: if isSelf(uid) || isTeacher();
      allow create: if isSelf(uid) && (
        request.resource.data.role == 'student' ||
        request.resource.data.email == 'trntui6@gmail.com'
      );
      allow update: if isTeacher() || (
        isSelf(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        changedKeys().hasOnly(['name', 'class', 'emailVerified', 'updatedAt']) &&
        (!('class' in changedKeys()) || classChangeOn()
          || resource.data.class == null || resource.data.class == '')
      );
      allow delete: if isTeacher();
    }

    // ── SETTINGS ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── LESSONS ──
    match /lessons/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // ── ASSIGNMENTS + ĐÁP ÁN ẨN ──
    match /assignments/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
      match /answerKey/{keyId} {
        allow read, write: if isTeacher();
      }
    }

    // ── SUBMISSIONS: HS KHÔNG BAO GIỜ ghi được điểm ──
    match /submissions/{id} {
      allow get, list: if isTeacher()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.score == null
        && request.resource.data.autoScore == null;
      allow update: if isTeacher() || (
        signedIn() && resource.data.studentId == request.auth.uid && (
          (resource.data.status == 'in_progress'
            && changedKeys().hasOnly(['draftAnswers', 'draftAt'])) ||
          (resource.data.status == 'in_progress'
            && request.resource.data.status == 'submitted'
            && changedKeys().hasOnly(['status', 'answers', 'answer', 'submittedAt',
                                      'submittedAtMs', 'timeSpent', 'isLate', 'isTimeout'])) ||
          (resource.data.status == 'in_progress'
            && request.resource.data.status == 'abandoned'
            && changedKeys().hasOnly(['status', 'answer', 'abandonedAt', 'submittedAt'])) ||
          (changedKeys().hasOnly(['studentViewed'])
            && request.resource.data.studentViewed == true)
        )
      );
      allow delete: if isTeacher();
    }

    // ── VIEW LOGS ──
    match /viewLogs/{id} {
      allow get, list: if isTeacher()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() || (
        signedIn() && resource.data.studentId == request.auth.uid &&
        changedKeys().hasOnly(['durationSec', 'lastHeartbeat', 'closedAt'])
      );
      allow delete: if isTeacher();
    }

    // ── NOTIFICATIONS ──
    match /notifications/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // ── AUDIT LOGS ──
    match /auditLogs/{id} {
      allow read, create: if isTeacher();
      allow update, delete: if false;
    }

    // ── CHẶN TẤT CẢ PHẦN CÒN LẠI ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}